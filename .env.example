# === Required ===
NEON_DATABASE_URL=
# One key from any LLM provider (see recipes below). OpenAI keys start with
# sk- / sk-proj-; Anthropic keys start with sk-ant- (auto-routes to the native
# Messages API + web_search_20250305); other OpenAI-compat providers use their
# own prefix. The var name is retained across providers.
OPENAI_API_KEY=

# === Required only when AGENT_RUNTIME=daytona (the default) ===
DAYTONA_API_KEY=
DAYTONA_TARGET=us

# Agent runtime: 'daytona' (default) or 'subprocess' (run the Python agent
# as a local child process — no Daytona account needed for local dev).
AGENT_RUNTIME=daytona

# Optional — override to use an OpenAI-compatible endpoint (Azure OpenAI, OpenRouter,
# vLLM, LiteLLM, a local server, etc). Leave unset to use the default https://api.openai.com/v1.
OPENAI_API_URL=

# Optional — override the model the agent calls. Leave unset to use gpt-4.1-mini.
# Must be supported by whichever endpoint OPENAI_API_URL points at.
OPENAI_MODEL=

# Optional — pick which OpenAI-style API surface the agent calls.
# Unset/'true' (default): use the Responses API (/v1/responses) + hosted web_search tool.
# 'false': use chat.completions (/v1/chat/completions). Still wires the three custom
# data tools (get_financials, get_valuation, get_earnings) but drops web_search
# (Responses-only). Required for Ollama, vLLM, LiteLLM, OpenRouter, Azure, and most
# other non-OpenAI endpoints. IGNORED on the Anthropic native path (sk-ant- keys).
OPENAI_USE_RESPONSES_API=

# --- Agentic thesis engine ---
# The agent researches a bull/bear thesis with the OpenAI web_search tool
# (or Anthropic's web_search_20250305 when OPENAI_API_KEY starts with sk-ant-).
# AGENT_MAX_ITERS=6            # max tool-call turns per analysis
# AGENT_LOOP_TIMEOUT_S=90      # wall-clock budget for the tool loop (seconds)
# ANTHROPIC_MAX_TOKENS=4096    # max_tokens on the Anthropic Messages call (sk-ant- path only)

# ----------------------------------------------------------------------------
# Recipes — uncomment ONE block and set OPENAI_API_KEY above accordingly.
# Each block overrides the relevant OPENAI_* vars together (Claude only needs
# two — the sk-ant- prefix auto-routes to the native Anthropic path).
# ----------------------------------------------------------------------------

# --- OpenAI (default — Responses API + hosted web_search) ---
# OPENAI_API_URL=
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_USE_RESPONSES_API=
# OPENAI_API_KEY=sk-proj-…
# Notes: leaving OPENAI_API_URL + OPENAI_USE_RESPONSES_API empty IS the OpenAI
# default. Only this recipe supports live web_search grounding.

# --- Claude (Anthropic native Messages API + web_search_20250305) ---
# OPENAI_API_KEY=sk-ant-…
# OPENAI_MODEL=claude-sonnet-4-6
# Notes: A key starting with sk-ant- auto-routes to the native Anthropic
# Messages API — OPENAI_API_URL and OPENAI_USE_RESPONSES_API are IGNORED on
# this path. The agent wires the three custom data tools (get_financials,
# get_valuation, get_earnings) plus Anthropic's hosted web_search_20250305
# server tool. Web search must first be enabled per-workspace in the Anthropic
# Console → Settings → Privacy → Web Search or the tool call is silently
# dropped. Try claude-opus-4-7 for the top tier or claude-haiku-4-5-20251001
# for fastest/cheapest. (Prior versions of this recipe used the OpenAI-compat
# layer at https://api.anthropic.com/v1 — that path had no web_search; the
# native route is now the default for Anthropic keys.)

# --- OpenRouter (any model, via OpenAI-compat router) ---
# OPENAI_API_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=anthropic/claude-sonnet-4-5
# OPENAI_USE_RESPONSES_API=false
# OPENAI_API_KEY=sk-or-v1-…
# Notes: model slugs follow "<provider>/<model>", e.g. openai/gpt-4.1-mini,
# google/gemini-2.5-pro, meta-llama/llama-3.3-70b. Appending ":online" to a
# slug (e.g. anthropic/claude-sonnet-4-5:online) enables OpenRouter's hosted
# web search add-on for that request.

# --- Ollama Cloud (open-weight models, no web_search) ---
# OPENAI_API_URL=https://ollama.com/v1
# OPENAI_MODEL=gpt-oss:120b-cloud
# OPENAI_USE_RESPONSES_API=false
# OPENAI_API_KEY=<your Ollama Cloud API key>
# Notes: model names use Ollama's "<name>:<tag>-cloud" form. Browse available
# models at https://ollama.com/library. No hosted web_search; outputs may
# include prose preamble that parse_response()'s ```json fence strip handles.

# === Observability (optional — set the block for whichever vendor you want) ===
# Sentry
SENTRY_DSN_NEXTJS=
SENTRY_DSN_AGENT=
SENTRY_AUTH_TOKEN=

# Datadog
DD_API_KEY=
DD_SITE=datadoghq.com
DD_SERVICE=stock-agent-frontend
DD_ENV=development
# Set to 'false' when running locally without a Datadog Agent on localhost:8126
# to silence "failed to send, dropping N traces" warnings from dd-trace.
DD_TRACE_ENABLED=

# --- OTLP transport (vendor-agnostic; traces + metrics + logs) ---
# Standard OpenTelemetry vars. Set a base for all signals and/or per-signal
# overrides. Auth (e.g. Datadog dd-api-key) rides in the _HEADERS var as
# comma-separated key=value pairs.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
# OTEL_EXPORTER_OTLP_METRICS_HEADERS=
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
# OTEL_EXPORTER_OTLP_LOGS_HEADERS=
#
# Datadog convenience: if DD_API_KEY is set (and DD_TRACE_ENABLED != false) and
# the matching OTEL_* var is unset, all three signals auto-target Datadog's
# agentless intake https://otlp.<DD_SITE>/v1/<signal> with a dd-api-key header.
# DD_EXPORTER=otlp   # 'otlp' (default, agentless) or 'agent' (local Agent :8126)
