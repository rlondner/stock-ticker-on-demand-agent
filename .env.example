# === Required ===
DAYTONA_API_KEY=
DAYTONA_TARGET=us
NEON_DATABASE_URL=
OPENAI_API_KEY=

# Agent runtime: 'daytona' (default) or 'subprocess' (run the Python agent
# as a local child process — no Daytona account needed for local dev).
AGENT_RUNTIME=daytona

# Optional — override to use an OpenAI-compatible endpoint (Azure OpenAI, OpenRouter,
# vLLM, LiteLLM, a local server, etc). Leave unset to use the default https://api.openai.com/v1.
OPENAI_API_URL=

# Optional — override the model the agent calls. Leave unset to use gpt-4.1-mini.
# Must be supported by whichever endpoint OPENAI_API_URL points at.
OPENAI_MODEL=

# Optional — pick which OpenAI-style API surface the agent calls.
# Unset/'true' (default): use the Responses API (/v1/responses) + hosted web_search tool.
# 'false': use chat.completions (/v1/chat/completions) without web_search — required for
# Ollama, vLLM, LiteLLM, OpenRouter, Azure, and most non-OpenAI endpoints.
OPENAI_USE_RESPONSES_API=

# === Observability (optional — set the block for whichever vendor you want) ===
# Sentry
SENTRY_DSN_NEXTJS=
SENTRY_DSN_AGENT=
SENTRY_AUTH_TOKEN=

# Datadog
DD_API_KEY=
DD_SITE=datadoghq.com
DD_SERVICE=stock-agent-frontend
DD_ENV=development
